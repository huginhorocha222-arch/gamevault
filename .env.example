# Copie este arquivo para ".env" e preencha com os dados reais do seu ambiente.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Conexão com o banco de dados (MySQL/MariaDB do XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamevault
DB_USER=root
DB_PASS=

# URL base da aplicação (opcional). Se vazio, é detectada automaticamente.
# Ex.: http://localhost/gamevault
APP_URL=
